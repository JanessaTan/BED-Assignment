# Application
NODE_ENV=development
PORT=3000

# Microsoft SQL Server
DB_SERVER=localhost
DB_PORT=1433
DB_DATABASE=HawkerCentreManagementSystem
DB_USER=replace_with_sql_server_user
DB_PASSWORD=replace_with_sql_server_password
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true
DB_POOL_MAX=10

# JWT authentication
# Use at least 32 random characters.
JWT_SECRET=replace_with_a_random_secret_of_at_least_32_characters
JWT_EXPIRES_IN=2h

# Password hashing
BCRYPT_ROUNDS=12

# Frontend origins when using Live Server
CORS_ORIGINS=http://127.0.0.1:5500,http://localhost:5500,http://127.0.0.1:3000,http://localhost:3000

# External API identification
NOMINATIM_USER_AGENT=HawkerHub-Student-Project/1.0